# Copy the relevant values into server/.env and client/.env.
# Never commit real credentials.

DATABASE_URL=postgresql://yibiao:yibiao@127.0.0.1:5432/yibiao_web
# 必须替换为高熵随机值（如 openssl rand -hex 32）；使用本占位符会拒绝启动。
JWT_SECRET=CHANGE_ME
HOST=127.0.0.1
PORT=3000
YIBIAO_DATA_DIR=./data
VITE_API_BASE_URL=/api
VITE_SOURCE_REPOSITORY_URL=https://github.com/shalishali/THB-20261018
