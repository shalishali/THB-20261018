  @@id([projectId, section])
  @@index([userId])
  @@map("duplicate_check_analysis_sections")
}

// 查重文件解析内容（fileId 一对一，按项目隔离）。
model DuplicateCheckContentFile {
  projectId     Int
  userId        Int?
  user          User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId        String @id
  status        String
  contentPath   String?
  contentLength Int     @default(0)
  parserLabel   String?
  error         String?
  updatedAt     String

  @@index([projectId])
  @@index([status])
  @@index([userId])
