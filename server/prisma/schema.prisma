// =============================================================================
// prompt_templates —— 提示词管理（全公司共享，admin 维护）。
// 把招标解析 18 项 task prompt + 共用 system prompt + 废标检查 invalid_bid prompt
// 从硬编码常量改为 DB 驱动（带硬编码兜底）。runnerKey 区分管线，itemKey 区分项；
// isSystem 行（itemKey='__system__'）= 投标分析 system prompt。内置项 builtin=true 不可物理删除。
// =============================================================================
model PromptTemplate {
  id          String   @id @default(cuid())
  runnerKey   String // 'bid-analysis' | 'rejection-check'
  itemKey     String // 'projectOverview' | '__system__' | 'invalid_bid' | <自定义>
  label       String
  description String   @default("")
  groupName   String   @default("") // 显示分组；自定义项='自定义'
  output      String   @default("markdown") // 'markdown' | 'json'
  required    Boolean  @default(false)
  promptText  String // 完整 prompt 文本（JSON 项=展开后全文）
  enabled     Boolean  @default(true)
  builtin     Boolean  @default(true) // 内置项不可物理删除
  isSystem    Boolean  @default(false) // bid-analysis system prompt 专用
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([runnerKey, itemKey])
  @@index([runnerKey, enabled, sortOrder])
  @@map("prompt_templates")
}

model AiDiagnosticRun {
  traceId       String                @id
  projectId     Int?
  userId        Int?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  taskType      String?
  operation     String
  provider      String                @default("")
  model         String                @default("")
  requestMode   String                @default("")
  status        String                @default("running")
  stage         String                @default("request")
  errorCode     String?
  errorMessage  String?
  degraded      Boolean               @default(false)
  metadata      Json?
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?
  expiresAt     DateTime
  attempts      AiDiagnosticAttempt[]

  @@index([projectId, startedAt])
  @@index([taskType, startedAt])
  @@index([status, startedAt])
  @@index([expiresAt])
  @@index([userId])
  @@map("ai_diagnostic_runs")
}

model AiDiagnosticAttempt {
  id            String          @id @default(cuid())
  traceId       String
  run           AiDiagnosticRun @relation(fields: [traceId], references: [traceId], onDelete: Cascade)
  attemptNo     Int
  phase         String
  stage         String
  status        String          @default("running")
  httpStatus    Int?
  durationMs    Int?
  requestChars  Int             @default(0)
  requestMeta   Json?
  responseChars Int             @default(0)
  responseHash  String?
  responseShape Json?
  issues        Json?
  responseFile  String?
  createdAt     DateTime        @default(now())

  @@index([traceId, createdAt])
  @@map("ai_diagnostic_attempts")
}

// 字数额度充值订单（一期：仅落单与状态流转；支付宝/微信支付网关接入后由回调置为 paid）
model QuotaOrder {
  id          String    @id @default(cuid())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey     String
  chars       Int
  amountCents Int
  channel     String // alipay / wechat
  status      String    @default("pending") // pending / paid / closed
  outTradeNo  String    @unique
  payUrl      String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("quota_orders")
}

// 管理员操作日志：记录管理员手动调整用户信息的行为（额度调整、账号编辑、删除等）
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      Int
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId Int?
  targetUser   User?    @relation("AdminAuditTargetLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String // quota.adjust / user.update / user.delete
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_audit_logs")
}

// 字数额度消费流水（DB-17）：导出扣费逐笔记录，支撑消耗流水查询与对账
model QuotaConsumeLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  Int?
  chars      Int
  fingerprint String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("quota_consume_logs")
}

// 返利比例配置（DB-19）：单行表 id=1；管理员后台维护全局比例与冻结周期
model RebateConfig {
  id            Int    @id @default(1)
  rebatePercent Int    @default(40) // 返利比例（%，被邀请人实付金额的百分比）
  freezeDays    Int    @default(30) // 冻结周期（天），到期可结算
  updatedAt     DateTime @updatedAt

  @@map("rebate_config")
}

// 站点访问记录（匿名/登录均记，用于"多少人访问了网站"；保留期由运维定期清理）
model VisitLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String
  ua        String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("visit_logs")
}

// 用户操作记录（关键动作：登录/注册/建项目/导入/启动生成/导出等）
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}
