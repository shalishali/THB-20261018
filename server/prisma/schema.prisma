}

// 查重大纲两两比对（按项目隔离）。UNIQUE(fileAId, fileBId)。
model DuplicateCheckOutlinePairwise {
  id              Int     @id @default(autoincrement())
  projectId       Int
  userId          Int?
  user            User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileAId         String
  fileBId         String
  score           Float   @default(0)
  titleOverlap    Float   @default(0)
  pathOverlap     Float   @default(0)
  orderSimilarity Float   @default(0)
  sharedCount     Int     @default(0)
  risk            String  @default("none")

  @@unique([fileAId, fileBId])
  @@index([projectId])
  @@index([score])
  @@index([userId])
  @@map("duplicate_check_outline_pairwise")
}

