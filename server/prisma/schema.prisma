// =============================================================================
// rejection_check_* —— 废标项检查（按项目隔离，共 8 表；分区键=projectId）。
// SaaS 个人版改造（DB-10/11）：userId 升级为 User 外键（onDelete: Cascade）并建索引。
// =============================================================================

// 废标检查元数据（每项目一行）。PK=projectId。
model RejectionCheckMeta {
  projectId            Int    @id
  userId               Int?
  user                 User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  step                 String @default("documents")
  activeDocumentTab    String @default("tender")
  activeResultTab      String @default("analysis")
  activeCheckResultTab String @default("rejection")
  customCheckItems     String @default("")
  checkOptionsJson     Json?
  createdAt            String
  updatedAt            String

  @@index([userId])
  @@map("rejection_check_meta")
}

// 废标检查文档（按项目隔离，多份投标文件：documentId=tender 或 bid-N）。
model RejectionCheckDocument {
  projectId     Int
  userId        Int?
  user          User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId    String
  role          String
  source        String
  fileName      String
  markdownPath  String
  contentHash   String
  contentChars  Int     @default(0)
  parserLabel   String?
  sortOrder     Int     @default(0)
  importedAt    String
  updatedAt     String

  @@id([projectId, documentId])
  @@index([projectId])
  @@index([role, sortOrder])
  @@index([userId])
  @@map("rejection_check_documents")
}

// 废标检查异步任务（每项目按 type 一条）。
model RejectionCheckTask {
  projectId    Int
  userId       Int?
  user         User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  taskId       String
  status       String
  progress     Int     @default(0)
  logsJson     Json?
  statsJson    Json?
  error        String?
  startedAt    String
  updatedAt    String

  @@id([projectId, type])
  @@index([userId])
  @@map("rejection_check_tasks")
}

// 废标检查招标要求抽取（每项目一行）。桌面 updated_at 可空 → Web updatedAt String?。
model RejectionCheckExtraction {
