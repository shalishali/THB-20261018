}

// 查重文件元数据项（按项目隔离）。UNIQUE(fileId, key)。
model DuplicateCheckMetadataItem {
  id             Int     @id @default(autoincrement())
  projectId      Int
  userId         Int?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId         String
  key            String
  label          String
  value          String  @default("")
  normalized     String?
  dateDay        String?
  comparable     Int     @default(0)
  dateComparable Int     @default(0)
  sortOrder      Int     @default(0)

  @@unique([fileId, key])
  @@index([projectId])
  @@index([fileId, sortOrder])
  @@index([key])
  @@index([userId])
  @@map("duplicate_check_metadata_items")
}

// 查重大纲条目（自引用树，按项目隔离）。
model DuplicateCheckOutlineItem {
  projectId             Int
  userId                Int?
  user                  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId                String @id
  fileId                String
  parentItemId          String?
  level                 Int
  number                String?
  title                 String
  normalizedTitle       String
  pathTitlesJson        Json
  normalizedPath        String
  source                String
  confidence            Float  @default(0)
  sortOrder             Int    @default(0)
  fromTender            Int    @default(0)
  matchedTenderSentence String?

  @@index([projectId])
  @@index([fileId, sortOrder])
  @@index([normalizedTitle, normalizedPath])
  @@index([userId])
  @@map("duplicate_check_outline_items")
}

// 查重大纲分组（按项目隔离）。
model DuplicateCheckOutlineGroup {
  projectId    Int
  userId       Int?
  user         User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String @id
  type         String
