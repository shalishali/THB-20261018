{
  "name": "openbidkit-yibiao-web-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "基于 OpenBidKit_Yibiao 二次开发的 Fastify + Prisma + PostgreSQL Web 后端",
  "author": "mark / yibiaoai; Web modifications by jdcome",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/shalishali/THB-20261018.git",
    "directory": "server"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script --exit-code",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.4",
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^6.2.1",
    "adm-zip": "^0.6.1",
    "ajv": "8.17.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cfb": "^1.2.2",
    "chardet": "^2.1.1",
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "iconv-lite": "^0.7.2",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.1",
    "markdown-it-cjk-friendly": "^2.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "mime-types": "^3.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "1.1.38",
    "undici": "^6.28.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
