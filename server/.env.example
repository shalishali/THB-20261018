DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/yibiao_web
JWT_SECRET=replace-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=3000
YIBIAO_DATA_DIR=./data

# ---- AI 调用 ----
# 单次 AI 请求超时上限（毫秒，默认 600000=10 分钟，最低 30000）。
# 搭配 Key 池（多平台）使用：收紧（如 300000=5 分钟）可让慢端点上的卡顿调用更早失败，
# 重试自动轮换到池中下一个条目（跨平台失败转移）。长上下文扩写/全文修复任务建议 ≥300000。
# AI_REQUEST_TIMEOUT_MS=300000

# ---- 安全加固（生产必配/建议配置）----

# CORS 来源白名单（逗号分隔）。不设置时服务端放行任意 Origin（仅限本地开发）。
# CORS_ORIGINS=https://your-domain.com

# AI 密钥落库加密密钥（任意长随机字符串；AES-256-GCM 派生）。
# 不设置时 API Key 明文落库（仅建议开发环境）。设置后请勿随意更换，否则已存密钥无法解密。
# CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-string

# 初始管理员密码（仅首次 seed 生效）。生产不设置时首启会生成随机密码并打印一次；
# 开发环境默认 admin/admin（首登强制改密）。
# ADMIN_INITIAL_PASSWORD=

# SSE 长连接全局上限（默认 500）
# SSE_MAX_CONNECTIONS=500

# 限流桶容量上限（默认 10000，防内存被伪造 IP 撑爆）
# RATE_LIMIT_MAX_BUCKETS=10000

# 反向代理层数（默认 1）：只有直连对端是回环/内网地址（即确有反代）时才读 X-Forwarded-For，
# 并从链尾倒数第 N 跳取真实客户端 IP。直连公网时完全忽略该头，避免伪造 IP 绕过限流/污染注册 IP。
# 部署形态：Nginx 单层 → 1；CDN + Nginx 两层 → 2。
# TRUSTED_PROXY_HOPS=1

# ---- 邮件 / 找回密码 ----
# 开发模式（默认 false）。为 true 时 /forgot-password 的响应体会直接带回 devResetUrl
# （等同改密凭证），仅限本地/内网调试；NODE_ENV=production 时强制失效。
# MAIL_DEV_MODE=false
# 前端站点根地址，用于拼接重置密码链接（不设置时回落到 http://<Host>，HTTPS 站点会拼出错误协议）。
# WEB_BASE_URL=https://your-domain.com
