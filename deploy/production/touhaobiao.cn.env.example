# 投好标生产环境变量模板（touhaobiao.cn）
# 复制到 server/.env 后逐项填写；不要把真实密钥提交仓库或发聊天。

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# 生产数据目录（与备份目录分开）
YIBIAO_DATA_DIR=/opt/touhaobiao/data
# 反向代理层数：Nginx 单层填 1；CDN + Nginx 填 2
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgresql://touhaobiao:CHANGE_ME@127.0.0.1:5432/touhaobiao
# 必须替换：openssl rand -hex 32；占位符会拒绝启动
JWT_SECRET=CHANGE_ME
# 必须替换：任意长随机字符串；设置后不要再改，否则已存 AI Key 无法解密
CONFIG_ENCRYPTION_KEY=CHANGE_ME

# 前端来源白名单（生产和 www 都加；上线前确认是否需要 www）
CORS_ORIGINS=https://touhaobiao.cn,https://www.touhaobiao.cn
# 邀请链接/支付回跳使用的站点根地址
WEB_BASE_URL=https://touhaobiao.cn

# 初始管理员：生产必须显式设置强密码，或留空读取 seed 首启日志中的随机密码
ADMIN_INITIAL_PASSWORD=

# ---- 短信（备案通过后填阿里云审核通过的签名/模板）----
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
# SMS_CODE_SECRET=  # 建议独立随机值；不填回落 JWT_SECRET

# ---- 支付（联调完成前保持 0，不开放充值）----
PAYMENT_ENABLED=0
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_PRIVATE_KEY=
PAYMENT_ALIPAY_PUBLIC_KEY=
PAYMENT_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAYMENT_ALIPAY_NOTIFY_URL=https://touhaobiao.cn/api/payment/alipay/notify
PAYMENT_ALIPAY_RETURN_URL=https://touhaobiao.cn/?recharge=done
PAYMENT_WECHAT_MCH_ID=
PAYMENT_WECHAT_APP_ID=
PAYMENT_WECHAT_API_V3_KEY=
PAYMENT_WECHAT_CERT_SERIAL_NO=
PAYMENT_WECHAT_PRIVATE_KEY=
PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY=
PAYMENT_WECHAT_PLATFORM_SERIAL_NO=
PAYMENT_WECHAT_NOTIFY_URL=https://touhaobiao.cn/api/payment/wechat/notify

# 统计时区
STATS_TIME_ZONE=Asia/Shanghai
